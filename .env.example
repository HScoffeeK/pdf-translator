# 复制为 .env 后按需修改;所有项均可省略,存在合理默认值
# 环境变量前缀 PDT_,如 PDT_ENGINE=llm

# ---- 服务 ----
# 监听地址;部署到服务器/Docker 时改为 0.0.0.0
PDT_HOST=127.0.0.1
PDT_PORT=8765
# 数据目录(数据库、上传文件);默认 <项目>/data
PDT_DATA_DIR=
# 访问令牌;留空=本地免鉴权,部署到公网务必设置
PDT_API_TOKEN=

# ---- 翻译 ----
# 默认引擎:google | llm | mock(需 PDT_ENABLE_MOCK=1)
PDT_ENGINE=google
PDT_TARGET_LANG=zh-CN
PDT_SOURCE_LANG=auto
# 术语表文件(TOML,可选);不存在则忽略
PDT_GLOSSARY_FILE=glossary.toml
# 遇到 References/Bibliography 章节即停止(论文参考文献一般无需翻译)
PDT_SKIP_REFERENCES=true

# ---- 引擎:LLM(OpenAI 兼容协议,默认关闭,填 key 即可用)----
PDT_LLM_BASE_URL=https://api.deepseek.com/v1
PDT_LLM_API_KEY=
PDT_LLM_MODEL=deepseek-chat

# ---- 限流 ----
# 同时翻译的段落数
PDT_MAX_CONCURRENCY=4
# 同一引擎两次请求的最小间隔(毫秒),防止触发限流
PDT_REQUEST_INTERVAL_MS=200

# ---- 其他 ----
PDT_MAX_UPLOAD_MB=50
# 暴露 mock 引擎(仅供测试)
PDT_ENABLE_MOCK=false
